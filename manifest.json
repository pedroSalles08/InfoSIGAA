{
  "manifest_version": 3,
  "name": "InfoSIGAA",
  "description": "Exibe avaliações, resultados semestrais, média anual, faltas e frequência do SIGAA em um dashboard local.",
  "version": "0.2.0",
  "incognito": "split",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://sig.iffarroupilha.edu.br/sigaa/*"],
  "action": {
    "default_title": "InfoSIGAA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://sig.iffarroupilha.edu.br/sigaa/*"],
      "js": ["src/sigaa-lock.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
